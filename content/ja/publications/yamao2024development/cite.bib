@inproceedings{Yamao2024Development,
  title     = {{Development of a SayCan-based Task Planning System Capable of Handling Abstract Nouns}},
  author    = {Kosei Yamao and Daiju Kanaoka and Kosei Isomoto and Akinobu Mizutani and Yuichiro Tanaka and Hakaru Tamukoh},
  booktitle = {Proceedings of the 2024 International Conference on Artificial Life and Robotics (ICAROB2024)},
  year      = {2024},
  month     = {feb},
  abstract  = {The task planning system is required to accomplish various requests from a human in real -world environments. SayCan, one of the task planning systems, has high accuracy . However, its accuracy decreases for requests that include abstract nouns of the ambiguous word/phrase. We propose a novel task planning system based on SayCan that introduces a function for checking concrete names of abstract nouns and a rule -based skill extraction , enhancing accuracy . The proposed system facilitates the interpretation of requests and enables appropriate task planning. The effectiveness of the proposed system was demonstrated at RoboCup@Home, where it achieved high performance .}
}
