@inproceedings{Kanaoka2020Object,
  title     = {{Object Recognition Using Tactile Information and Its Application to Service Robots}},
  author    = {Daiju Kanaoka and Yutaro Ishida and Hakaru Tamukoh},
  booktitle = {Proceedings of the International Workshop on Smart Info-Media Systems in Asia (SISA2020)},
  year      = {2020},
  month     = {oct},
  abstract  = {Most object recognition in service robots are based on image information; however, objects with similar appearance can possibly be misrecognized. Therefore, object recognition with other information in addition to the image information is required. This study investigates the effectiveness of object recognition using tactile information. We perform an experiment using the TOYOTA-Human Support Robot to obtain the tactile information of objects and classify them by random forest. The experimental results show that the object recognition accuracy with tactile information is 92.8\%, which enables us to classify objects that have been difficult to classify with image formation only. I. I NTRODUCTION Service robots that support people’s daily life activities in the domestic environment have been attracting attention in the recent years. Object recognition is one of the important functions for service robots to work together with humans and often implemented by using a camera on a robot. However, this method faces several problems including the facts that the recognition results are affected by the environment (e.g., color of the lighting) and objects with similar appearance and color are misrecognized. Aside from images, tactile information (e.g., object weight and softness) has also been attracting attention as features. Accordingly, methods combining image and tactile information, such as object pose estimation and in-hand manipulation, have been reported [1][2]. The effectiveness of object recognition using tactile information has been shown in previous studies [3][4], in which objects are grasped by a robot hand that imitates a human hand. The robot hand is equipped with a number of tactile sensors, and object recognition is based on the tactile information obtained from these sensors. A previous study [4] also achieved an object recognition accuracy of more than 90\%. However, a robot hand with a complex structure and a large number of sensors is likely to be damaged; therefore, a robot hand with a simple structure and a small number of sensors is deemed suitable for a service robot. This study examine the effectiveness of the tactile information obtained from an end-effector of a robot arm with a simple structure and few sensors in object recognition. Our goal is to develop an object recognition system with tactile information to recognize objects that are difficult to recognize by image information only.}
}
